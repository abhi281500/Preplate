# ==============================================================================
# PREPLATE PLATFORM CONFIGURATION TEMPLATE
# Copy to .env for local development. Never commit actual secret keys.
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:5173

# Database (MongoDB connection string)
# For local development with Docker or local mongod:
MONGODB_URI=mongodb://localhost:27017/preplate_dev
# In automated test environments, an in-memory database will run automatically if MONGODB_URI is not provided.

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Super Admin Seed (Used on first run to initialize platform administrator)
SUPERADMIN_EMAIL=superadmin@preplate.io
SUPERADMIN_PASSWORD=Admin@Preplate2026!
SUPERADMIN_NAME=Platform Super Admin

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# WhatsApp Integration Configuration
# For MVP, deep links wa.me are used without API credentials.
# Advanced WhatsApp Cloud API (Optional post-pilot):
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
